# =============================================================================
# Production Multi-Tenant PBX - Environment & Credentials Template
# Copy this file to .env and fill in your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application Settings
# -----------------------------------------------------------------------------
PROJECT_NAME="Production Multi-Tenant PBX"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# -----------------------------------------------------------------------------
# 2. Security & JWT Authentication
# -----------------------------------------------------------------------------
SECRET_KEY="super-secret-jwt-signing-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="pbx_user"
POSTGRES_PASSWORD="pbx_password_secure"
POSTGRES_DB="pbx_db"
DATABASE_URL="postgresql+asyncpg://pbx_user:pbx_password_secure@postgres:5432/pbx_db"

# -----------------------------------------------------------------------------
# 4. Redis Cache & Multi-Worker Pub/Sub
# -----------------------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"

# -----------------------------------------------------------------------------
# 5. FreeSWITCH Settings
# -----------------------------------------------------------------------------
FREESWITCH_ESL_HOST="freeswitch"
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD="ClueCon"
FREESWITCH_DOMAIN="pbx.local"

# -----------------------------------------------------------------------------
# 6. Audio Storage Provider (local, s3, gcs)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="/var/lib/freeswitch/recordings"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""
GCS_BUCKET_NAME=""

# =============================================================================
# Virtual QA, Real-Time Audio AI & Coaching Credentials
# =============================================================================

# -----------------------------------------------------------------------------
# 7. ElevenLabs API (Speech-to-Text & Real-Time Whisper Audio TTS)
# -----------------------------------------------------------------------------
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v1"
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# -----------------------------------------------------------------------------
# 8. Google Gemini & Vertex AI (Semantic Policy & Compliance Evaluation)
# -----------------------------------------------------------------------------
# Option A: Google AI Studio API Key (recommended / easiest)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Option B: Vertex AI Service Account (For Enterprise Google Cloud deployments)
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
GEMINI_LLM_APPLICATION_CREDENTIALS_JSON=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GEMINI_QA_MODEL="gemini-1.5-flash"

# -----------------------------------------------------------------------------
# 9. Virtual QA Pipeline & Audio Worker Runtime Settings
# -----------------------------------------------------------------------------
QA_DEMO_MODE=false
QA_RECORDINGS_DIR="/var/lib/freeswitch/recordings"
QA_POLL_INTERVAL_SEC=2.0
QA_WINDOW_SEC=6.0
QA_WINDOW_OVERLAP_SEC=1.5
QA_SILENCE_RMS=350.0
QA_MAX_CONCURRENT_AI=8
QA_LEADER_LOCK_TTL_SEC=30
QA_EVENT_RETENTION_DAYS=30
