# =============================================================================
# Production Multi-Tenant PBX - Environment & Credentials Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application Settings
# -----------------------------------------------------------------------------
PROJECT_NAME="Production Multi-Tenant PBX"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# -----------------------------------------------------------------------------
# 2. Security & JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure 32+ character random key for production (e.g. openssl rand -hex 32)
SECRET_KEY="super-secret-jwt-signing-key-change-this-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="pbx_user"
POSTGRES_PASSWORD="pbx_password_secure"
POSTGRES_DB="pbx_db"
DATABASE_URL="postgresql+asyncpg://pbx_user:pbx_password_secure@localhost:5432/pbx_db"

# -----------------------------------------------------------------------------
# 4. Redis Cache & Multi-Worker Pub/Sub
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# -----------------------------------------------------------------------------
# 5. FreeSWITCH Telephony Engine & Event Socket Library (ESL)
# -----------------------------------------------------------------------------
FREESWITCH_ESL_HOST="localhost"
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD="ClueCon"
FREESWITCH_DOMAIN="pbx.local"

# -----------------------------------------------------------------------------
# 6. Audio Storage Provider (local, s3, gcs)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="/var/lib/freeswitch/recordings"

# AWS S3 Storage Credentials (Optional - required only if STORAGE_PROVIDER="s3")
# Generate in AWS IAM: Users -> Security credentials -> Access keys
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# Google Cloud Storage (Optional - required only if STORAGE_PROVIDER="gcs")
GCS_BUCKET_NAME=""

# =============================================================================
# Virtual QA, Real-Time Audio AI & Coaching Credentials
# =============================================================================

# -----------------------------------------------------------------------------
# 7. ElevenLabs API (Speech-to-Text & Real-Time Whisper Audio TTS)
# -----------------------------------------------------------------------------
# Where to get: Log in to https://elevenlabs.io -> Profile / Settings -> API Keys
# Required for:
#   - High-accuracy agent speech transcription (Scribe STT)
#   - Dynamic ultra-low-latency whisper coaching audio generation (Flash v2.5 TTS)
ELEVENLABS_API_KEY=""

# Model & Voice IDs
ELEVENLABS_STT_MODEL="scribe_v1"
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
# Default voice: "JBFqnCBsd6RMkjVDRZzb" (George - clear coaching voice). 
# Browse other voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# -----------------------------------------------------------------------------
# 8. Google Gemini & Vertex AI (Semantic Policy & Compliance Evaluation)
# -----------------------------------------------------------------------------
# Option A: Google AI Studio API Key (Simplest & Recommended)
# Where to get: Go to https://aistudio.google.com/app/apikey -> Create API Key
# Paste your "AIzaSy..." key below:
GEMINI_API_KEY=""

# Option B: Vertex AI Service Account (For Enterprise Google Cloud deployments)
# Path to service account JSON keyfile (e.g. /path/to/sa-credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"

# Gemini Model identifier: "gemini-3.5-flash", "gemini-2.5-flash", or "gemini-1.5-flash"
GEMINI_QA_MODEL="gemini-3.5-flash"

# -----------------------------------------------------------------------------
# 9. Virtual QA Pipeline & Audio Worker Runtime Settings
# -----------------------------------------------------------------------------
# Set to true to run mock tailing without requiring live FreeSWITCH audio files
QA_DEMO_MODE=false

# Directory where FreeSWITCH stores live unbuffered stereo WAV recordings
QA_RECORDINGS_DIR="/var/lib/freeswitch/recordings"

# Polling interval to check WAV file size growth (seconds)
QA_POLL_INTERVAL_SEC=2.0

# Sliding audio window for transcription chunking (seconds)
QA_WINDOW_SEC=6.0
QA_WINDOW_OVERLAP_SEC=1.5

# Silence cutoff threshold (RMS). Audio below this energy is skipped to save AI cost
QA_SILENCE_RMS=350.0

# Concurrency & Distributed Redis Leader Lock
QA_MAX_CONCURRENT_AI=8
QA_LEADER_LOCK_TTL_SEC=30
QA_EVENT_RETENTION_DAYS=30
